# Atlas — environment template.
# Copy to .env and fill in real values. NEVER commit the filled .env.

# --- Core ---
# Application environment: development | production
ATLAS_ENV=development

# Public base URL used for OAuth callbacks and links (must be HTTPS in production).
PUBLIC_BASE_URL=https://atlas.example.com

# Optional: comma-separated Host header allow-list. Strongly recommended in production to
# prevent host-header attacks (e.g. ALLOWED_HOSTS=atlas.example.com).
ALLOWED_HOSTS=

# --- Secrets (generate strong random values; do not reuse) ---
# Application secret used for signing; e.g. `openssl rand -hex 32`
SECRET_KEY=change-me
# Session signing secret; e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# Key used to encrypt stored OAuth tokens at rest; back this up separately.
# e.g. `openssl rand -base64 32`
TOKEN_ENCRYPTION_KEY=change-me

# --- Database ---
DATABASE_URL=postgresql+psycopg://atlas:change-me@db:5432/atlas

# --- Markdown storage ---
# Absolute path inside the container to the notes root.
NOTES_ROOT=/data/atlas/notes
# How often the worker re-scans the notes root and updates the index (seconds).
NOTES_RECONCILE_SECONDS=300

# --- Google Calendar (optional; required for Google integration) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OAuth redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI=https://atlas.example.com/api/calendar/google/callback

# --- Microsoft Graph (optional; required for Outlook integration) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use a tenant id, or `common` for multi-tenant + personal accounts.
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=https://atlas.example.com/api/calendar/microsoft/callback

# --- Notifications / Web Push (required for desktop/PWA push) ---
# Generate a VAPID key pair; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Mobile push (later milestone) ---
# FCM server credentials or Expo access token, depending on the chosen delivery path.
FCM_CREDENTIALS_JSON=
EXPO_ACCESS_TOKEN=
