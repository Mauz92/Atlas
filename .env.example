# Atlas — environment template.
# Copy to .env and fill in real values. NEVER commit the filled .env.

# --- Core ---
# Application environment: development | production
ATLAS_ENV=development

# Public base URL used for OAuth callbacks and links (must be HTTPS in production).
PUBLIC_BASE_URL=https://atlas.example.com

# Optional: comma-separated Host header allow-list. Strongly recommended in production to
# prevent host-header attacks (e.g. ALLOWED_HOSTS=atlas.example.com).
ALLOWED_HOSTS=

# --- Secrets (generate strong random values; do not reuse) ---
# Application secret used for signing; e.g. `openssl rand -hex 32`
SECRET_KEY=change-me
# Session signing secret; e.g. `openssl rand -hex 32`
SESSION_SECRET=change-me
# Key used to encrypt stored OAuth tokens at rest; back this up separately.
# Must be a strong random value (e.g. `openssl rand -base64 32`) and is required in production.
TOKEN_ENCRYPTION_KEY=change-me
# Identifier for the key above, recorded with each stored credential so keys can be rotated.
# Rotate by bumping this (e.g. to v2), setting a new TOKEN_ENCRYPTION_KEY, and moving the previous
# key into TOKEN_ENCRYPTION_PREVIOUS_KEYS until every row is re-encrypted.
TOKEN_ENCRYPTION_KEY_ID=v1
# Optional JSON map of retired keys (key id -> key material) that may still decrypt older rows.
# Leave unset normally; set a JSON object during a key rotation, e.g.
# TOKEN_ENCRYPTION_PREVIOUS_KEYS={"v1":"<previous-key>"}

# --- Account recovery (AUTH-01, ADR-0067) ---
# true (default): a one-time recovery code is shown at first-run setup and can be regenerated in
# Settings -> Account; "Forgot password?" on the sign-in page resets the password with it.
# false: no code is issued, the forgot-password endpoint answers 404, and the only way back into a
# forgotten password is `atlas-admin reset-password` on the server (docs/OPERATOR_GUIDE.md).
RECOVERY_ENABLED=true

# --- Database ---
# Docker Compose: set POSTGRES_PASSWORD (it initialises the db service AND builds the api/worker
# DATABASE_URL, so the two always agree). Use a URL-safe value, e.g. `openssl rand -hex 16`.
# Fixed on first start: changing it later does not change the password inside an existing volume.
POSTGRES_PASSWORD=change-me
# POSTGRES_USER=atlas
# POSTGRES_DB=atlas
# DATABASE_URL below is for runs outside Compose (host venv, tests, migrations from the host);
# Compose ignores it.
DATABASE_URL=postgresql+psycopg://atlas:change-me@127.0.0.1:5432/atlas

# --- Web container (Compose) ---
# The web container publishes on 127.0.0.1:WEB_PORT by default; HTTPS is added by `tailscale serve`
# or a reverse proxy on the same host (docs/DEPLOYMENT.md section 8). WEB_BIND=0.0.0.0 publishes it
# on every interface (plain HTTP): only behind a firewall you control.
WEB_PORT=8080
WEB_BIND=127.0.0.1

# --- Markdown storage ---
# Absolute path inside the container to the notes root.
NOTES_ROOT=/data/atlas/notes
# How often the worker re-scans the notes root and updates the index (seconds).
NOTES_RECONCILE_SECONDS=300

# --- Backups (M9-01) ---
# Destination directory for backup sets. Each set holds a PostgreSQL dump, a notes archive and a
# checksummed manifest. Must be a durable, ideally off-volume location; nothing is written outside it.
BACKUP_DIR=/data/atlas/backups
# How many of the newest backup sets to keep; older sets are pruned automatically.
BACKUP_RETAIN=7
# How often (seconds) the worker produces a backup (default: daily).
BACKUP_INTERVAL_SECONDS=86400
# Where pg_dump runs. Leave blank to use the local client (installed in the image). Set to a
# PostgreSQL container name (e.g. atlas-db-1) to run pg_dump inside it with `docker exec` on a host
# that has no local PostgreSQL client.
BACKUP_PG_DUMP_CONTAINER=

# --- Full data export (M9-03) ---
# Destination directory for the operator `atlas-export` CLI's export sets (a portability artifact,
# not a backup). `GET /api/export` streams a zip and does not use this.
EXPORT_DIR=/data/atlas/exports

# --- Sync / change feed ---
# How long (days, at least 30) the change feed keeps deletion tombstones (default 90). Older tombstones
# are purged by a durable job, and so are idempotency keys and automatic-resolution log entries
# (SYNC-05: the overwritten simple values behind "changed on another device" and undo); user
# task/project/note rows are never purged. A device away for longer than this is told to resync (without losing its pending edits).
# The same window is how long a sync device (SYNC-06) may stay unseen before it must sign in again with the
# account password, and how long a signed-out device is remembered.
CHANGE_RETENTION_DAYS=90
# How often (seconds) the worker runs the change-feed purge.
CHANGE_PURGE_INTERVAL_SECONDS=3600
# Note history (SYNC-04): the server keeps the text of recent note revisions as the base of a
# three-way merge for sync clients. A note keeps its newest NOTE_HISTORY_KEEP_REVISIONS revisions and
# every revision younger than NOTE_HISTORY_KEEP_DAYS, but never more than NOTE_HISTORY_MAX_REVISIONS
# revisions or NOTE_HISTORY_MAX_BYTES of distinct text. The files live in <notes root>/.atlas/history,
# are part of every backup, and keep the text of overwritten or deleted notes for that long.
NOTE_HISTORY_KEEP_REVISIONS=20
NOTE_HISTORY_KEEP_DAYS=90
NOTE_HISTORY_MAX_REVISIONS=200
NOTE_HISTORY_MAX_BYTES=67108864

# --- Calendars (Stage A, read-only; setup guide: docs/CALENDAR_SYNC.md "Setup guide") ---
# The OAuth redirect URIs are NOT configured here: they are always built from PUBLIC_BASE_URL as
#   {PUBLIC_BASE_URL}/api/calendar/google/callback
#   {PUBLIC_BASE_URL}/api/calendar/microsoft/callback
# and must match what you register at the provider exactly. Leave a client id empty to leave that
# provider "not configured" (Settings -> Calendar then shows setup help instead of a Connect button).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# `common` = personal + work accounts, `consumers` = personal only, or a single tenant id.
MICROSOFT_TENANT=common
# Secret ICS feeds (Proton "Share via link" and any other ICS URL): poll interval (min 300 s), size cap
# (bytes) and request timeout (s). Proton refreshes its own feeds slowly, so more often is pointless.
ICS_POLL_SECONDS=900
ICS_MAX_BYTES=10485760
ICS_TIMEOUT_SECONDS=20
# Development only. http:// feeds / feeds on private or loopback addresses are refused by default
# (SSRF); ICS_ALLOW_PRIVATE_HOSTS makes the API refuse to start when ATLAS_ENV=production.
ICS_ALLOW_HTTP=false
ICS_ALLOW_PRIVATE_HOSTS=false
# Microsoft delta window (days either side of today) and OAuth state lifetime (s).
CALENDAR_WINDOW_PAST_DAYS=90
CALENDAR_WINDOW_FUTURE_DAYS=365
CALENDAR_OAUTH_STATE_TTL_SECONDS=600
# Test/dev only: route calendar OAuth/API calls to a local fake provider. Refused in production.
CALENDAR_FAKE_PROVIDER_URL=

# --- Notifications / Web Push (M8-02; optional — leave unset to disable Web Push) ---
# VAPID application-server keys (RFC 8292). The PUBLIC key is handed to the browser; the PRIVATE key
# signs each push and MUST be kept secret (never committed). Generate a pair once with the documented
# step in docs/DEPLOYMENT.md §"Web Push (VAPID keys)" — it prints both values. VAPID_SUBJECT is the
# contact (a mailto: or https: URL) a push service may use for the sender. When any value is missing,
# Web Push is disabled cleanly and reminders fall back to the server log (no crash).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Live updates and the optional sync hint (M8-04e; all optional) ---
# GET /api/sync/wait is a long poll the desktop app uses while it runs. It holds a request at most
# SYNC_WAIT_MAX_SECONDS (keep it at most 55: the shipped nginx waits 75 s for the API).
SYNC_WAIT_MAX_SECONDS=25
SYNC_WAIT_POLL_SECONDS=2
SYNC_WAIT_MAX_CONNECTIONS=4
# An optional, content-free "sync now" message to YOUR OWN ntfy server, so a backgrounded Android
# phone refreshes. Off by default. The gateway origin is set here only; devices may register only
# topic URLs on exactly this origin. REQUIRED hardening (auth, ACL, token, HTTPS): the operator guide
# section "Instant updates with a self-hosted ntfy". Never point this at a server you do not run
# unless you accept that the TIMING of your edits is visible to it (no content is ever sent).
SYNC_HINT_ENABLED=false
SYNC_HINT_GATEWAY_URL=
# An ntfy access token (tk_...) with write-only access to up*, if your ntfy requires one to publish.
SYNC_HINT_GATEWAY_TOKEN=
# Plain http only for a gateway on a LAN or tailnet you control (traffic is not encrypted by Atlas).
SYNC_HINT_ALLOW_INSECURE_HTTP=false
SYNC_HINT_MIN_INTERVAL_SECONDS=30
SYNC_HINT_TIMEOUT_SECONDS=5
SYNC_HINT_ON_REMINDER=true

# --- Mobile push (later milestone) ---
# FCM server credentials or Expo access token, depending on the chosen delivery path.
FCM_CREDENTIALS_JSON=
EXPO_ACCESS_TOKEN=

# TTRPG module (optional, off until enabled in Settings > Plugins). The SRD monster catalogue is
# fetched on demand from this origin: only catalogue requests are sent, never campaign or player
# data. Set TTRPG_SRD_ENABLED=false for a fully offline install (manual creature cards still work).
TTRPG_SRD_ENABLED=true
TTRPG_SRD_BASE_URL=https://www.dnd5eapi.co
TTRPG_SRD_TIMEOUT_SECONDS=8
