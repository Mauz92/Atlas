{
  "name": "atlas-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && (cd ../../packages/sync-core && ../../apps/web/node_modules/.bin/eslint .) && (cd ../../packages/reminder-core && ../../apps/web/node_modules/.bin/eslint .) && (cd ../../packages/desktop-core && ../../apps/web/node_modules/.bin/eslint .) && (cd ../desktop && ../web/node_modules/.bin/eslint src) && node scripts/check-css-scale.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "test:e2e:real": "playwright test -c playwright.real.config.ts",
    "gen:api": "openapi-typescript ../../services/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
