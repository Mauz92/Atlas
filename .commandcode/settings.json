{
  "permissions": {
    "defaultMode": "yolo",
    "deny": [
      "Shell(git push:*)",
      "Shell(git commit:*)",
      "Shell(git merge:*)",
      "Shell(git rebase:*)",
      "Shell(git reset --hard:*)",
      "Shell(git clean -*)",
      "Edit(.dev-supervisor.toml)",
      "Edit(scripts/verify.sh)",
      "Edit(AGENTS.md)"
    ]
  }
}
